FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system athar \
    && adduser --system --ingroup athar --home /app athar

COPY pyproject.toml README.md ./
COPY mock_open_banking ./mock_open_banking

RUN python -m pip install --upgrade pip \
    && python -m pip install .

USER athar

EXPOSE 8100

CMD ["python", "-m", "uvicorn", "mock_open_banking.main:app", "--host", "0.0.0.0", "--port", "8100"]
