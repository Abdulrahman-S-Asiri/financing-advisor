{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "next-intl": ["./src/lib/next-intl/index.tsx"],
      "next-intl/middleware": ["./src/lib/next-intl/middleware.ts"],
      "next-intl/navigation": ["./src/lib/next-intl/navigation.tsx"],
      "next-intl/routing": ["./src/lib/next-intl/routing.ts"],
      "next-intl/server": ["./src/lib/next-intl/server.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
