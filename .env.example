# Copy to .env for local development. Do not put real secrets in this file.
# python-dotenv or your shell loads these values for the backend and tooling.

# Provider selection: auto, anthropic, or deepseek.
LLM_PROVIDER=auto

# Anthropic provider. In auto mode, this is preferred when configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=

# DeepSeek provider through the Anthropic-compatible Messages API.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# Open Banking adapter. mock keeps the demo on the seeded local AIS service.
OPEN_BANKING_PROVIDER=mock
MOCK_OB_BASE_URL=http://127.0.0.1:8100

# Frontend rewrite target for /backend/*.
BACKEND_URL=http://127.0.0.1:8000

# Optional Postgres persistence. The sample URL matches docker-compose.yml
# local-only credentials.
DATABASE_URL=postgresql://amad:amad@localhost:5432/amad
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# In-memory LRU caps used when Postgres is disabled or as the hot cache.
JOURNEY_STORE_MAX=500
APPLICATION_STORE_MAX=500

# Local simulated OTP settings. Production should replace this with Nafath or
# an approved identity provider.
AUTH_OTP_TTL_MINUTES=5
AUTH_SESSION_TTL_HOURS=24
