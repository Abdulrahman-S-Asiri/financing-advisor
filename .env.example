# Copy to .env - python-dotenv or your shell loads it.
LLM_PROVIDER=auto

# Anthropic provider. In auto mode, this is preferred when configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=

# DeepSeek provider through the Anthropic-compatible Messages API.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

OPEN_BANKING_PROVIDER=mock
MOCK_OB_BASE_URL=http://127.0.0.1:8100
DATABASE_URL=postgresql://amad:amad@localhost:5432/amad

# Local simulated OTP settings. Production should replace this with Nafath or
# an approved identity provider.
AUTH_OTP_TTL_MINUTES=5
AUTH_SESSION_TTL_HOURS=24
